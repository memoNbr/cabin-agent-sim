# Copy to a new file called ".env" and fill in the values.

# Which LLM backend: "groq" | "ollama" | "scripted"
#   groq     -> free cloud tier, ~300 ms/call, ~30 req/min (key at console.groq.com)
#              — THIS PROJECT'S DEFAULT BRAIN: flip LLM_PROVIDER to groq below
#   ollama   -> 100% local, offline fallback (needs Ollama + a model pulled)
#   scripted -> deterministic stand-in, no key needed (ships as this file's
#               default so a fresh clone runs silent)
# Any failure (401/429/network/bad JSON) falls back to rules for that tick.
LLM_PROVIDER=scripted

# Only used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=allam-2-7b

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Qwen3 hidden thinking costs ~19 s per call with zero output — keep it off
# (0.75 s/call), with a small output cap and a trimmed KV cache.
OLLAMA_THINK=0
OLLAMA_NUM_PREDICT=160
OLLAMA_NUM_CTX=1536

# Optional: a different model for experimenter chat ONLY (hybrid:
# ticks/deliberation keep the model above, chat gets this one).
# Leave unset/commented = same model for both lanes.
# CHAT_MODEL=
