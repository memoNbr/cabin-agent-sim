# Copy to a new file called ".env" and fill in the values.

# Which LLM backend: "groq" | "ollama" | "scripted"
#   groq     -> free, very fast, small model (needs a free key at console.groq.com)
#   ollama   -> 100% local (needs Ollama installed + a model pulled)
#   scripted -> deterministic stand-in, no key needed (default)
LLM_PROVIDER=scripted

# Only used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=allam-2-7b

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2